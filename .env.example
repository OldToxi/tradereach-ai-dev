# Copy to .env.local and fill. Never commit .env.local.
# Every one of these must also be set in the Vercel project.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses row-level security. Read only by lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=
# For migrations and the seed script only.
SUPABASE_DB_URL=

# --- Anthropic ---
ANTHROPIC_API_KEY=
AI_MODEL_DRAFTING=claude-sonnet-4-6
AI_MODEL_CLASSIFY=claude-haiku-4-5-20251001
AI_MONTHLY_CAP_USD=120

# --- Google (Gmail compose + Calendar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# stub = no login, DEV_USER is assumed. Throws if NODE_ENV=production.
AUTH_MODE=live
DEV_USER=rifat.hasan@anwargroup.test

# --- Demo safety. Do not relax. ---
# Outreach recipients must match this pattern.
ALLOWED_RECIPIENT_PATTERN=%.test
# Hard off switch for any send path. Gmail scope is compose-only regardless.
ENABLE_OUTBOUND_SEND=false
